# --------------------------------------------------
# General application configuration
# --------------------------------------------------

APP_NAME=LLM API Gateway
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
LOG_LEVEL=INFO


# --------------------------------------------------
# Gateway authentication
# --------------------------------------------------

# Replace this with a securely generated value.
GATEWAY_API_KEY=replace-this-development-key


# --------------------------------------------------
# LLM provider
# --------------------------------------------------

LLM_PROVIDER=ollama

# Use localhost while the API is running directly on your machine.
# Docker Compose will later override this with http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434

# This is a placeholder until Ollama is configured.
OLLAMA_MODEL=placeholder-model


# --------------------------------------------------
# Redis and caching
# --------------------------------------------------

# Use localhost while the API runs directly on your machine.
# Docker Compose will later use redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

CACHE_TTL_SECONDS=3600


# --------------------------------------------------
# Provider timeouts and retries
# --------------------------------------------------

CONNECT_TIMEOUT_SECONDS=5
READ_TIMEOUT_SECONDS=120
RETRY_ATTEMPTS=3


# --------------------------------------------------
# Rate limiting
# --------------------------------------------------

RATE_LIMIT_PER_MINUTE=30
